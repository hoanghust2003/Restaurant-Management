# =======================
# API CONFIGURATION
# =======================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# =======================
# APP CONFIGURATION
# =======================
NEXT_PUBLIC_APP_NAME=Restaurant Management System
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Modern restaurant management system

# =======================
# UPLOAD CONFIGURATION
# =======================
NEXT_PUBLIC_MAX_FILE_SIZE=5242880
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg
NEXT_PUBLIC_UPLOAD_ENDPOINT=/api/upload

# =======================
# VNPAY PAYMENT (Frontend URLs)
# =======================
NEXT_PUBLIC_VNPAY_RETURN_URL=http://localhost:3000/payment/return
NEXT_PUBLIC_VNPAY_CANCEL_URL=http://localhost:3000/payment/cancel

# =======================
# GOOGLE ANALYTICS (Optional)
# =======================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =======================
# ENVIRONMENT SETTINGS
# =======================
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_DEBUG=true

# =======================
# WEBSOCKET CONFIGURATION
# =======================
NEXT_PUBLIC_ENABLE_WEBSOCKET=true
NEXT_PUBLIC_WEBSOCKET_RECONNECT_INTERVAL=5000

# =======================
# UI CONFIGURATION
# =======================
NEXT_PUBLIC_DEFAULT_LOCALE=vi
NEXT_PUBLIC_AVAILABLE_LOCALES=vi,en
NEXT_PUBLIC_THEME=light
